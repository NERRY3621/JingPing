<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="78dp"
                android:layout_height="38dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rhine_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.16"
                    android:text="@string/brand_overline"
                    android:textColor="@color/accent"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/text_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/version_label"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/stroke_soft" />

        <!-- 使用教程入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/guide_entry_title"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/guide_entry_desc"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGuide"
                style="@style/BtnGhost"
                android:layout_marginStart="12dp"
                android:text="@string/guide_view" />
        </LinearLayout>

        <!-- 状态 -->
        <TextView style="@style/SectionLabel" android:text="@string/section_status" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dotAccess"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/dot_grey" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/RowTitle" android:text="@string/status_access" />

                    <TextView
                        android:id="@+id/tvAccessDetail"
                        style="@style/RowDesc"
                        android:text="@string/access_detail_off" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAccess"
                    style="@style/BtnMini"
                    android:layout_marginStart="10dp"
                    android:text="开启" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/stroke_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dotShizuku"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/dot_grey" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/RowTitle" android:text="@string/status_shizuku" />

                    <TextView
                        android:id="@+id/tvShizukuDetail"
                        style="@style/RowDesc"
                        android:text="@string/shizuku_detail_off" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnShizuku"
                    style="@style/BtnMini"
                    android:layout_marginStart="10dp"
                    android:text="授权" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/stroke_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dotRoot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/dot_grey" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/RowTitle" android:text="@string/status_root" />

                    <TextView
                        android:id="@+id/tvRootDetail"
                        style="@style/RowDesc"
                        android:text="@string/root_detail_checking" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRoot"
                    style="@style/BtnMini"
                    android:layout_marginStart="10dp"
                    android:text="检测" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/stroke_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dotLsposed"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/dot_grey" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/RowTitle" android:text="@string/status_lsposed" />

                    <TextView
                        android:id="@+id/tvLsposedDetail"
                        style="@style/RowDesc"
                        android:text="@string/lsposed_detail_missing" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnLsposed"
                    style="@style/BtnMini"
                    android:layout_marginStart="10dp"
                    android:text="打开" />
            </LinearLayout>
        </LinearLayout>

        <!-- 防护开关 -->
        <TextView style="@style/SectionLabel" android:text="@string/section_protection" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/switch_enabled_title"
                        android:textSize="15sp" />

                    <TextView style="@style/RowDesc" android:text="@string/switch_enabled_desc" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/stroke_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/RowTitle" android:text="@string/switch_click_title" />

                    <TextView style="@style/RowDesc" android:text="@string/switch_click_desc" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swClickSkip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/stroke_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/RowTitle" android:text="@string/switch_back_title" />

                    <TextView style="@style/RowDesc" android:text="@string/switch_back_desc" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swBackAd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/stroke_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/RowTitle" android:text="@string/switch_jump_title" />

                    <TextView style="@style/RowDesc" android:text="@string/switch_jump_desc" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swIntercept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/stroke_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/RowTitle" android:text="@string/guard_title" />

                    <TextView
                        android:id="@+id/tvGuardDetail"
                        style="@style/RowDesc"
                        android:text="@string/guard_desc_off" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swGuard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 生效范围 -->
        <TextView style="@style/SectionLabel" android:text="@string/section_scope" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvScopeSummary"
                        style="@style/RowTitle"
                        android:text="@string/scope_all"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvScopeDetail"
                        style="@style/RowDesc"
                        android:text="@string/scope_detail_all" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnScope"
                    style="@style/BtnGhost"
                    android:layout_marginStart="12dp"
                    android:text="@string/scope_manage" />
            </LinearLayout>
        </LinearLayout>

        <!-- 深度净化 -->
        <TextView style="@style/SectionLabel" android:text="@string/section_clean" />

        <LinearLayout
            android:id="@+id/cardClean"
            style="@style/Card">

            <TextView style="@style/RowDesc" android:text="@string/clean_desc" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnScan"
                    style="@style/BtnGhost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/clean_scan"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnClean"
                    style="@style/BtnPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:text="@string/clean_do"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRestore"
                    style="@style/BtnGhost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/clean_restore"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCleanResult"
                style="@style/RowDesc"
                android:layout_marginTop="10dp"
                android:text="@string/clean_idle" />
        </LinearLayout>

        <!-- 自检 -->
        <TextView style="@style/SectionLabel" android:text="@string/section_test" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/RowTitle" android:text="@string/test_title" />

                    <TextView style="@style/RowDesc" android:text="@string/test_desc" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnTest"
                    style="@style/BtnGhost"
                    android:layout_marginStart="12dp"
                    android:text="@string/test_start" />
            </LinearLayout>
        </LinearLayout>

        <!-- 日志 -->
        <TextView style="@style/SectionLabel" android:text="@string/section_log" />

        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_log"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:minHeight="86dp"
                android:padding="12dp"
                android:text="@string/log_empty"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp" />

            <Button
                android:id="@+id/btnClearLog"
                style="@style/BtnMini"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:text="@string/log_clear" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="本地运行 · 不联网 · 不修改应用安装包\nAndroid 8.0+ · 建议配合 LSPosed 使用"
            android:textColor="@color/text_dim"
            android:textSize="10.5sp" />
    </LinearLayout>
</ScrollView>
